# Copy to .env for command-line Compose, or set this in Dockhand's stack environment.
# Use your HOME ASSISTANT browser origin, not the Matterbase server URL.
# Examples (replace with your own address):
# MATTERBASE_FRAME_ANCESTORS=http://192.0.2.10:8123
# MATTERBASE_FRAME_ANCESTORS=https://ha.example.com
# Multiple origins: separate with spaces, without paths or wildcards.
# Leave blank for standalone-only use. Required by compose.homeassistant.yaml.
MATTERBASE_FRAME_ANCESTORS=

# Optional pairing instructions; this does not commission anything automatically.
# MATTERBASE_HOME_ASSISTANT_HELP=1
