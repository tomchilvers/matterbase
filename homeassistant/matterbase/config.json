{
  "name": "Matterbase",
  "version": "1.0.0-ha.3",
  "slug": "matterbase",
  "description": "A private inventory of Matter pairing codes, with local scanning and portable backups.",
  "url": "https://github.com/tomchilvers/matterbase",
  "arch": ["aarch64", "amd64"],
  "image": "ghcr.io/tomchilvers/matterbase",
  "startup": "application",
  "boot": "auto",
  "init": true,
  "timeout": 30,
  "ingress": true,
  "ingress_port": 8000,
  "ingress_stream": true,
  "panel_icon": "mdi:qrcode-scan",
  "panel_title": "Matterbase",
  "panel_admin": true,
  "backup": "cold",
  "options": {"home_assistant_help": false},
  "schema": {"home_assistant_help": "bool"}
}
